<i18n:domain i18n:domain="collective.contact.widget"
             xmlns:tal="http://xml.zope.org/namespaces/tal"
             xmlns:metal="http://xml.zope.org/namespaces/metal"
             xmlns:i18n="http://xml.zope.org/namespaces/i18n">
$('#<tal:class replace="view/id"/>-autocomplete').find('.<tal:class replace="options/klass"/>').each(function() {
    var addlink = $(this);
    var addmsg = addlink.closest('.addnew-block');
    var input = $('#<tal:class replace="view/id"/>-widgets-query');
    input.attr('placeholder', '<tal:class replace="view/placeholder" i18n:translate=""/>');
    // collective.contact.core keeps a copy of the original href and text of
    // this link to rewrite it when an organization is selected: give it the
    // clean ones, before we add anything to the href.
    if (!addlink.data('original_src')) {
      addlink.data('original_src', addlink.attr('href'));
      addlink.data('original_text', addlink.text());
    }
    // The add forms accept prefill values from the GET request
    // (allow_prefill_from_GET_request): put the typed text in the link.
    var amp = String.fromCharCode(38);
    // Fields to prefill depend on the form the link leads to (types of
    // collective.contact.core). Only the dexterity add forms (++add++<type>,
    // 'form' prefix) have a field for the typed text: the title (IBasic) of an
    // organization or a position, the firstname and lastname of a person. The
    // held position form (++add++held_position) and the @@add-... forms only
    // have selection widgets and fields unrelated to the typed text.
    var prefill_params = function(value, url){
      var marker = '++add++';
      var start = url.indexOf(marker);
      if(!value || start === -1){
        return {};
      }
      var portal_type = url.slice(start + marker.length).split('/')[0].split('?')[0].split('#')[0];
      if(portal_type === 'organization' || portal_type === 'position'){
        return {'form.widgets.IBasic.title': value};
      }
      if(portal_type === 'person'){
        var words = $.grep(value.split(' '), function(word){ return word !== ''; });
        if(words.length === 1){
          return {'form.widgets.lastname': words[0]};
        }
        return {'form.widgets.firstname': words[0], 'form.widgets.lastname': words.slice(1).join(' ')};
      }
      return {};
    };
    // The href is rewritten by other scripts too: remove what we added the
    // last time (own_suffix) from the current href before adding the new text.
    var own_suffix = '';
    var prefill_href = function(){
      var href = addlink.attr('href');
      if(own_suffix && href.slice(-own_suffix.length) === own_suffix){
        href = href.slice(0, href.length - own_suffix.length);
      }
      var query = $.param(prefill_params(input.val().trim(), href));
      own_suffix = query ? (href.indexOf('?') === -1 ? '?' : amp) + query : '';
      addlink.attr('href', href + own_suffix);
    };
    // capture phase: also just before the click handler of pat-plone-modal
    addlink[0].addEventListener('click', prefill_href, true);
    var update_addmsg = function(){
      if(input.val().length>=2){
    	addmsg.show();
    	prefill_href();
      }
      if(input.val().length===0){
    	addmsg.hide();
    	prefill_href();
      }
    }
    input.each(update_addmsg) // do not hide if value is set from request
    // not keyup/focusout: pat-livesearch does .off('keyup') / .off('focusout')
    // on the input when it is initialized, which would remove these handlers
    input.on('input blur', update_addmsg);
});
</i18n:domain>
