<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:z3c="http://namespaces.zope.org/z3c">

  <adapter
      factory=".widgets.ContactAutocompleteMultiFieldWidget"
      for=".interfaces.IContactList
           z3c.form.interfaces.IFormLayer"
      />

  <adapter
      factory=".widgets.ContactAutocompleteFieldWidget"
      for=".interfaces.IContactChoice
           z3c.form.interfaces.IFormLayer"
      />

  <browser:page
      name="autocomplete-search"
      for=".interfaces.IContactAutocompleteWidget"
      permission="zope.Public"
      class=".widgets.AutocompleteSearch"
      />

  <browser:page
      name="livesearch-search"
      for=".interfaces.IContactAutocompleteWidget"
      permission="zope.Public"
      class=".widgets.LivesearchSearch"
      />

  <browser:viewlet
      name="term-contact"
      class=".widgets.TermViewlet"
      for=".interfaces.IContactContent"
      manager="plone.app.layout.viewlets.interfaces.IBelowContent"
      permission="zope2.View"
      />

  <!-- overrides the template registered for
       z3c.form.interfaces.ICheckBoxWidget -->
  <z3c:widgetTemplate
      mode="input"
      widget=".interfaces.IContactAutocompleteMultiSelectionWidget"
      layer="plone.app.z3cform.interfaces.IPloneFormLayer"
      template="templates/checkbox_input.pt"
      />

  <!-- overrides the template registered for
       z3c.form.interfaces.IRadioWidget -->
  <z3c:widgetTemplate
      mode="input"
      widget=".interfaces.IContactAutocompleteSelectionWidget"
      layer="plone.app.z3cform.interfaces.IPloneFormLayer"
      template="templates/radio_input.pt"
      />

  <!-- plone.app.z3cform registers RelationChoiceSelectWidgetConverter for
       IRelationChoice, which gives None for the sequence value of our radio
       widgets: nothing was saved -->
  <adapter factory=".converters.ContactChoiceSelectWidgetConverter" />
  <adapter factory=".converters.ContactListSelectWidgetConverter" />

</configure>
